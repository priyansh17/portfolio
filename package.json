{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "npm run dev",
    "predev": "npm run assets",
    "assets": "node scripts/optimize-images.mjs",
    "prebuild": "npm run assets",
    "build": "vite build && node scripts/build-aliases.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
